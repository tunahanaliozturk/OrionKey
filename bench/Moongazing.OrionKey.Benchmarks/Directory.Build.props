<Project>

  <!--
    Import the repository-wide build settings. This file exists so that the
    BenchmarkDotNet auto-generated boilerplate project (emitted under bin/) does
    not inherit the solution-wide multi-target framework set. BenchmarkDotNet
    sets ImportDirectoryBuildProps=false only inside the project body, which is
    evaluated after the implicit Directory.Build.props import has already run -
    so without this file the auto-generated project would multi-target
    net8.0;net9.0;net10.0 and fail to restore against this net10.0-only project.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Benchmarks (and their generated runner) are net10.0-only. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>

</Project>
