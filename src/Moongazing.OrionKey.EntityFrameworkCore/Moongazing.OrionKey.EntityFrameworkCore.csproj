<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>OrionKey.EntityFrameworkCore</PackageId>
    <Description>Model-wide EF Core value-converter registration for OrionKey strongly-typed IDs. One call, modelBuilder.UseOrionKeyConversions() (or configurationBuilder.ConfigureOrionKeyConversions() from ConfigureConventions), wires the converter for every [OrionId] property on the model, so you stop calling HasOrionKeyConversion() property by property.</Description>
    <PackageTags>strongly-typed-id;ef-core;entity-framework-core;value-converter;orionkey;ddd</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Moongazing.OrionKey\Moongazing.OrionKey.csproj" />
  </ItemGroup>
  <!--
    EF Core major must track the consumer's target framework: the 9.0.x/10.0.x packages do not
    restore on net8.0 (NU1202). Pin one matching major per TFM, the same split the integration
    test project uses, so every framework builds. EntityFrameworkCore (not the Relational or a
    provider package) is the minimal dependency: the convention and the value converter live in
    the core abstractions, leaving provider choice to the consumer.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\docs\icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="docs/README.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>
</Project>
